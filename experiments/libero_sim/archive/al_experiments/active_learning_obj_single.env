# active_learning_obj_single.env — frozen config for the 4-ARM object-centric single-scene
# active-learning ablation. Sourced by monitor_active_learning_obj_single.sh and carried into
# each arm's SLURM job via --export=ALL. active_learning_loop.py reads every knob from the env.
#
# The 4 arms differ ONLY in the score + keep rule (identical scene, task, mix, schedule, base
# ckpt, pool). This isolates: reducible-loss (vs raw) | diversity (vs top-K) | decision-awareness.
#   rand_obj     — random keep (control)
#   maxloss_obj  — raw object-region loss, top-K            (reproduces the July-8 null)
#   rho_div_obj  — reducible loss (vs frozen-30000) + diverse batch
#   decaware_obj — reducible loss x policy-relevance + diverse batch   (the proposed method)
#
# NOTE: this file is `source`d by bash; keep it POSIX (KEY=value, no spaces around =).

# ---- scene / task (single LIBERO-90 task) ----
SCENE_FILE="LIVING_ROOM_SCENE1_pick_up_the_tomato_sauce_and_put_it_in_the_basket_demo.hdf5"
SRC_LIBERO90="/storage/cedar/cedar0/cedarp-agarg35-0/liquan.w/LIBERO-datasets/libero_90"
SCENE_DIR="/storage/project/r-agarg35-0/lwang831/alr_obj_single_scene"   # symlink farm holding only SCENE_FILE

# ---- schedule ----
START_STEP=30000
TRAIN_TO_STEP=50000
ROUND_STEPS=1000
MAX_ROUNDS=20                       # 30000 + 20*1000 = 50000

# ---- candidate pool (identical for all arms; deterministic per round) ----
NUM_SHARDS=1                        # single scene -> every round builds the one task
PER_TASK_MIX="reach:10,perturb:14,random:6"   # ~30 candidates/round
SELECT_K=8                          # keep 8 of ~30 -> real selection pressure
BUFFER_CAP=160
GEN_STEPS=200
RES=256
FPS=15
RANDOM_SEED=20260708
# perturb source for the SHARED pool: "gt" seeds perturb off the GT demo (arm-independent,
# so all arms get byte-identical candidates). "buffer" would reintroduce per-arm divergence.
POOL_PERTURB_SOURCE="gt"

# ---- object-centric scorer (shared by all strategic arms) ----
SCORER="objbbox"                    # object-region pixel curiosity (not whole-frame latent)
GRADE_STEPS=20                      # rollout steps for the pixel scorer
SIGMA_GRID="0.2,0.4,0.6,0.8"
SEEDS="0,1,2"

# ---- reducible-loss reference (frozen step-30000; used by rho_div + decaware) ----
# learning-progress form: score = loss_ref30000 - loss_current  (see loop docstring / devlog).
REDUCIBLE_METRIC="progress_norm"
BASELINE_STEP=30000                 # the frozen reference checkpoint step

# ---- diversity (k-center over candidate latents; used by rho_div + decaware) ----
DIVERSE_OVERSAMPLE=0                 # 0 => 3*SELECT_K oversample before k-center

# ---- policy relevance (decaware only) ----
# v1: occupancy proxy = closeness (eef + object position space) to the GT-demo on-task manifold.
# No cross-repo FM-policy dependency; upgrade to FM-policy occupancy x action-sensitivity later.
POLICY_REL_VERSION="v1_gt_manifold"

# ---- the 4 arms: "job_name|arm_key". arm_key selects the ARM_CONFIGS entry in the loop. ----
ARMS="rand_obj|random maxloss_obj|maxloss rho_div_obj|rho_div decaware_obj|decaware"
MAX_JOBS=4

# ---- storage roots (FRESH; the old 2-arm gvt_obj_single run is untouched) ----
OUT_BASE="/storage/cedar/cedar0/cedarp-agarg35-0/liquan.w/outputs/gvt_obj_single_4arm"
STATE_BASE="/storage/project/r-agarg35-0/lwang831/alr_state_obj_single_4arm"
GROW_BASE="/storage/scratch1/8/lwang831/obj_single_4arm"
POOL_BASE="/storage/scratch1/8/lwang831/obj_single_4arm/pool"          # shared per-round candidate pools
START_CKPT_DIR="/storage/cedar/cedar0/cedarp-agarg35-0/liquan.w/outputs/gvt/libero90_v2v_ic_lora_prope/checkpoints"

# ---- eval ----
EVAL_ROOT="/storage/home/hcoda1/8/lwang831/workspace/LTX-GVT/experiments/libero_sim/outputs/active_learning_obj_single_4arm/evals"

# ---- watchdog ----
SLEEP_INTERVAL_MIN=15
