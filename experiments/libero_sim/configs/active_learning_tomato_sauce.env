# active_learning_tomato_sauce.env — object-interaction active-learning for the SINGLE
# tomato_sauce object. Sourced by monitor_active_tomato_sauce.sh and carried into each arm's
# SLURM job via --export=ALL. active_learning_loop.py reads every knob from the env.
#
# Difference vs active_learning_obj_single.env: the candidate pool now COVERS the physics-rich
# interaction family — crucially the new `poke` behavior (gripper-OPEN lateral push/topple, which
# excites object dynamics NOT determined by the gripper pose) alongside reach/perturb/random and
# the GT manifold. This directly tests the thesis: "understand the object's physics" = cover the
# space of possible interactions, and does strategic selection over that coverage help.
#
# The 4 arms still differ ONLY in the score + keep rule (identical scene, task, mix, schedule,
# base ckpt, pool):
#   rand_ts     — random keep (control)
#   maxloss_ts  — raw object-region loss, top-K
#   rho_div_ts  — reducible loss (vs frozen step-30000) + diverse batch
#   decaware_ts — reducible loss x policy-relevance + diverse batch   (proposed method)
#
# NOTE: `source`d by bash; keep it POSIX (KEY=value, no spaces around =).

# ---- scene / task (single LIBERO-90 task; object of interest = tomato_sauce) ----
SCENE_FILE="LIVING_ROOM_SCENE1_pick_up_the_tomato_sauce_and_put_it_in_the_basket_demo.hdf5"
SRC_LIBERO90="/storage/cedar/cedar0/cedarp-agarg35-0/liquan.w/LIBERO-datasets/libero_90"
SCENE_DIR="/storage/project/r-agarg35-0/lwang831/alr_tomato_sauce_scene"   # symlink farm: only SCENE_FILE
# Clean tomato_sauce-ONLY scene (table + tomato_sauce + basket, distractors removed). Pending
# validation by gen_clean_interact (job renders gt/reach/poke/random on it). When gen_libero_play
# is wired to honor CLEAN_BDDL, uncomment to generate the pool on the clean scene:
# CLEAN_BDDL="/storage/home/hcoda1/8/lwang831/workspace/LIBERO/libero/libero/bddl_files/libero_90/LIVING_ROOM_SCENE1_pick_up_the_tomato_sauce_and_put_it_in_the_basket_ONLY.bddl"

# ---- schedule ----
START_STEP=30000
TRAIN_TO_STEP=50000
ROUND_STEPS=1000
MAX_ROUNDS=20                       # 30000 + 20*1000 = 50000

# ---- candidate pool (identical for all arms; deterministic per round) ----
# COVERAGE mix: reach (grasp), poke (push/topple = physics), perturb (GT-manifold), random (broad).
# ~30 candidates/round; poke-weighted because it carries the object physics the model must learn.
NUM_SHARDS=1
PER_TASK_MIX="reach:6,poke:10,perturb:8,random:6"
SELECT_K=8                          # keep 8 of ~30 -> real selection pressure
BUFFER_CAP=160
GEN_STEPS=200
RES=256
FPS=15
RANDOM_SEED=20260726
# "gt" seeds perturb off the GT demo (arm-independent -> byte-identical pools across arms).
POOL_PERTURB_SOURCE="gt"

# ---- object-centric scorer (shared by all strategic arms) ----
SCORER="objbbox"                    # object-region pixel curiosity, masked to the tomato_sauce bbox
GRADE_STEPS=20
SIGMA_GRID="0.2,0.4,0.6,0.8"
SEEDS="0,1,2"

# ---- reducible-loss reference (frozen step-30000; used by rho_div + decaware) ----
REDUCIBLE_METRIC="progress_norm"
BASELINE_STEP=30000

# ---- diversity (k-center over candidate latents; used by rho_div + decaware) ----
DIVERSE_OVERSAMPLE=0                 # 0 => 3*SELECT_K oversample before k-center

# ---- policy relevance (decaware only) ----
POLICY_REL_VERSION="v1_gt_manifold"

# ---- the 4 arms: "job_name|arm_key". ----
ARMS="rand_ts|random maxloss_ts|maxloss rho_div_ts|rho_div decaware_ts|decaware"
MAX_JOBS=4

# ---- storage roots (FRESH; the gvt_obj_single_4arm run is untouched) ----
OUT_BASE="/storage/cedar/cedar0/cedarp-agarg35-0/liquan.w/outputs/gvt_tomato_sauce"
STATE_BASE="/storage/project/r-agarg35-0/lwang831/alr_state_tomato_sauce"
GROW_BASE="/storage/scratch1/8/lwang831/tomato_sauce"
POOL_BASE="/storage/scratch1/8/lwang831/tomato_sauce/pool"
START_CKPT_DIR="/storage/cedar/cedar0/cedarp-agarg35-0/liquan.w/outputs/gvt/libero90_v2v_ic_lora_prope/checkpoints"

# ---- eval ----
EVAL_ROOT="/storage/home/hcoda1/8/lwang831/workspace/LTX-GVT/experiments/libero_sim/outputs/active_learning_tomato_sauce/evals"

# ---- Perceptual Flow Matching loss (arXiv 2607.03524) ----
# Replaces latent-space velocity MSE with a perceptual distance: decode the recovered clean
# prediction x_hat0 through the frozen VAE (in-graph) and match it to the true clean frame in
# DINOv2 feature space. Read by trainer.py; carried into each arm via --export=ALL.
#   PFM_MSE_WEIGHT=0.0 => pure replacement (no latent MSE);  >0 => hybrid MSE+perceptual.
# Verified end-to-end on the 22B model (job 11517490, SMOKE_EXIT=0). ~6 GB extra on H200,
# ~2x slower per step (full 33-frame decode + DINOv2 every microbatch).
PFM_ENABLE=1
PFM_WEIGHT=1.0
PFM_MSE_WEIGHT=0.0
PFM_FRAMES=0                          # 0 = decode all latent frames (full clip)

# ---- watchdog ----
SLEEP_INTERVAL_MIN=15
